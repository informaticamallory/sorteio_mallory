# Copie para backend/.env e ajuste antes do evento.

# Chave de assinatura dos tokens de sessao. TROQUE EM PRODUCAO.
SECRET_KEY=troque-esta-chave-em-producao-sorteio-confraternizacao
TOKEN_EXPIRA_MINUTOS=720

# Banco de dados. Deixe comentado para usar o padrao: SQLite em DATA_DIR.
# ATENCAO: nao aponte para dentro do OneDrive/Dropbox - o sincronismo trava o
# arquivo e causa "database is locked" durante o evento.
# Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg://sorteio:senha@localhost:5432/sorteio

# Pasta do banco SQLite, dos backups e das imagens. Padrao: backend/data, ou
# %LOCALAPPDATA%\sorteio-confraternizacao quando o projeto esta numa pasta
# sincronizada.
# DATA_DIR=C:\sorteio-dados

# Fuso horario do evento. Os horarios sao gravados em UTC e convertidos aqui.
EVENT_TIMEZONE=America/Sao_Paulo

# Credenciais do organizador criado no primeiro boot. TROQUE A SENHA.
ADMIN_USUARIO=organizador
ADMIN_SENHA=sorteio2026
ADMIN_NOME=Organizador

# Limites de upload
MAX_UPLOAD_BYTES=5242880
MAX_PLANILHA_BYTES=10485760

# Origens permitidas (separadas por virgula). Em rede local, "*" e suficiente.
CORS_ORIGINS=*
